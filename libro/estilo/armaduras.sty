% Maqueta del libro "Análisis matricial de armaduras con Python".
%
% Todo el formato vive aquí. Los capítulos solo usan los comandos semánticos
% definidos al final de este archivo (ver docs/03-guia-de-estilo.md).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{estilo/armaduras}[2026/10/17 Maqueta del libro]

% Idioma, tipografía, colores, unidades, TikZ, notación y símbolos
\RequirePackage{estilo/base}
\addto\captionsspanish{\renewcommand{\appendixname}{Anexo}}
\RequirePackage[final]{microtype}

% ---------------------------------------------------------------------------
% Página: márgenes amplios con espacio para notas al margen
% ---------------------------------------------------------------------------
\RequirePackage[
  paperwidth=19cm, paperheight=24.5cm,
  inner=2.2cm, outer=5.4cm, top=2.4cm, bottom=2.6cm,
  marginparwidth=3.8cm, marginparsep=0.6cm,
]{geometry}
\RequirePackage{marginnote}
\renewcommand*{\marginfont}{\footnotesize\sffamily\color{texto-suave}}

% ---------------------------------------------------------------------------
% Títulos
% ---------------------------------------------------------------------------
\setkomafont{disposition}{\sffamily\color{principal}}
\setkomafont{chapter}{\sffamily\Huge\color{principal}}
\setkomafont{chapterprefix}{\sffamily\large\color{acento}}
\RedeclareSectionCommand[prefixfont=\sffamily\large\color{acento}]{chapter}
\KOMAoptions{chapterprefix=true}
\RequirePackage[automark, headsepline=0.4pt]{scrlayer-scrpage}
\pagestyle{scrheadings}
\setkomafont{pagehead}{\sffamily\footnotesize\color{texto-suave}}
\setkomafont{pagenumber}{\sffamily\footnotesize\color{principal}}

% ---------------------------------------------------------------------------
% Figuras, tablas y referencias
% ---------------------------------------------------------------------------
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\setkomafont{caption}{\small}
\setkomafont{captionlabel}{\small\sffamily\bfseries\color{principal}}
\numberwithin{equation}{chapter}

% ---------------------------------------------------------------------------
% Código (antes de csquotes, que debe cargarse después de fvextra)
% ---------------------------------------------------------------------------
\RequirePackage{minted}
\setminted{
  fontsize=\small,
  bgcolor=fondo-codigo,
  breaklines,
  style=friendly,
}

% ---------------------------------------------------------------------------
% Bibliografía, índice y referencias cruzadas
% ---------------------------------------------------------------------------
\RequirePackage{csquotes}
\RequirePackage[backend=biber, style=authoryear, maxcitenames=2]{biblatex}
\RequirePackage{imakeidx}
\makeindex[intoc, title={Índice alfabético}]
\PassOptionsToPackage{hyphens}{url}  % las direcciones largas se cortan en los guiones
\RequirePackage[hidelinks]{hyperref}
\expandafter\def\expandafter\UrlBreaks\expandafter{\UrlBreaks\do\_\do\.}
\Urlmuskip=0mu plus 2mu
\RequirePackage[spanish, noabbrev, nameinlink]{cleveref}
\crefname{table}{tabla}{tablas}
\Crefname{table}{Tabla}{Tablas}

% Páginas de alto variable: evita estirar el espacio entre párrafos y código
\raggedbottom
% Ruta de los fragmentos extraídos por scripts/extraer_fragmentos.py
\newcommand{\rutafragmentos}{../recursos/fragmentos}

% ---------------------------------------------------------------------------
% Cajas
% ---------------------------------------------------------------------------
\RequirePackage[most, minted]{tcolorbox}
\tcbset{
  caja/.style={
    enhanced, breakable, sharp corners, boxrule=0pt, frame hidden,
    borderline west={2.5pt}{0pt}{#1},
    colback=#1!6, left=10pt, right=8pt, top=6pt, bottom=6pt,
    fonttitle=\sffamily\bfseries\small, coltitle=#1,
    detach title, before upper={\tcbtitle\par\smallskip}, fontupper=\small,
  },
}


% ===========================================================================
% Comandos semánticos: lo único que usan los capítulos
% ===========================================================================

% Cajas de la plantilla de capítulo (docs/02-plantilla-capitulo.md)
\newtcolorbox{recuerda}{caja=principal, title={Recuerda}}
\newtcolorbox{python}{caja=traccion, title={Python}}
\newtcolorbox{cuidado}{caja=acento, title={Cuidado}}
\newtcolorbox{parasabermas}{caja=neutro, title={Para saber más}}

% Objetivos de aprendizaje, al inicio de cada capítulo
\newenvironment{objetivos}
  {\begin{tcolorbox}[caja=principal, title={Al terminar este capítulo podremos}]
   \begin{itemize}}
  {\end{itemize}\end{tcolorbox}}

% Fragmento de código con una sola fuente en codigo/
\newcommand{\fragmento}[1]{%
  \IfFileExists{\rutafragmentos/#1.py}
    {\inputminted{python}{\rutafragmentos/#1.py}}
    {\PackageError{armaduras}{No existe el fragmento '#1'}
      {Ejecute scripts/extraer_fragmentos.py o revise el nombre.}}%
}

% Salida que produce un fragmento al ejecutarse (generada por scripts/generar_salidas.py)
\newcommand{\rutasalidas}{../recursos/salidas}
\newcommand{\salida}[1]{%
  \IfFileExists{\rutasalidas/#1.txt}
    {\par\vspace{-0.6\baselineskip}%
     \VerbatimInput[fontsize=\small, frame=leftline, framerule=1.5pt,
       rulecolor=\color{neutro}, xleftmargin=4pt, framesep=8pt,
       formatcom=\color{texto-suave}, breaklines]{\rutasalidas/#1.txt}}
    {\PackageError{armaduras}{No existe la salida '#1'}
      {Ejecute scripts/generar_salidas.py o revise el nombre.}}%
}

% Gráfico que dibuja un fragmento al ejecutarse (generado por scripts/generar_salidas.py)
\newcommand{\rutagraficos}{../recursos/graficos}
\newcommand{\grafico}[1]{%
  \IfFileExists{\rutagraficos/#1.pdf}
    {\par\smallskip{\centering\includegraphics{\rutagraficos/#1.pdf}\par}\smallskip}
    {\PackageError{armaduras}{No existe el gráfico '#1'}
      {Ejecute scripts/generar_salidas.py o revise el nombre.}}%
}

% Código breve escrito en el texto (solo para ejemplos que no son de la calculadora)
\newminted[codigo]{python}{}
\newmintinline[py]{python}{bgcolor={}, breaklines, breakafter={,(}, breakbefore={.}}

% Nota al margen
\newcommand{\nota}[1]{\marginnote{#1}}

% Término técnico: primera aparición, con su equivalente en inglés y entrada en el índice
\newcommand{\termino}[2]{\emph{#1}\index{#1} (\emph{#2})}
% Término técnico que se escribe igual en inglés: solo se destaca y se indexa
\newcommand{\concepto}[1]{\emph{#1}\index{#1}}

% Punto de control al final de cada capítulo
\newcommand{\urlnotebooks}{https://github.com/eder3232/libro-rigidez-python-armaduras2d/blob/main/notebooks}
\newcommand{\puntodecontrol}[1]{%
  \begin{tcolorbox}[caja=acento, title={Punto de control}]
  Si algo no funcionó o se omitió una parte, el notebook con todo el código
  hasta este capítulo permite continuar desde aquí:\par\smallskip
  \url{\urlnotebooks/control_cap#1.ipynb}
  \end{tcolorbox}}

% Marca de contenido por escribir (desaparece de la versión final)
\newcommand{\pendiente}[1]{{\color{acento}\sffamily\small[Pendiente: #1]}}

% Contenido exclusivo de cada formato (scripts/latex_a_mdx.py los interpreta)
\newcommand{\sololibro}[1]{#1}
\newcommand{\soloweb}[1]{}

% Encabezado de la sección de ejercicios
\newcommand{\ejercicios}{\section*{Ejercicios}\addcontentsline{toc}{section}{Ejercicios}}

% ---------------------------------------------------------------------------
% Elementos inspirados en los libros de mecánica a todo color
% (referencia de diseño: Beer y Johnston, docs/03-guia-de-estilo.md)
% ---------------------------------------------------------------------------

% Problema resuelto: enunciado y solución, con banda de título a color
\newcounter{problemaresuelto}[chapter]
\renewcommand{\theproblemaresuelto}{\thechapter.\arabic{problemaresuelto}}
\newenvironment{problemaresuelto}[1][]
  {\refstepcounter{problemaresuelto}%
   \begin{tcolorbox}[enhanced, breakable, sharp corners, boxrule=0pt,
     colback=principal!4, colframe=principal, toprule=0pt,
     left=10pt, right=10pt, top=8pt, bottom=8pt,
     title={Problema resuelto \theproblemaresuelto\ifx\relax#1\relax\else\ \textperiodcentered\ #1\fi},
     fonttitle=\sffamily\bfseries, coltitle=white, colbacktitle=principal,
     boxed title style={sharp corners}]}
  {\end{tcolorbox}}
% Separador entre el enunciado y la solución, dentro de un problema resuelto
\newcommand{\solucion}{\par\medskip
  {\sffamily\bfseries\color{acento}Solución}\par\smallskip}

% Ecuación clave: resaltada con fondo de color
\newtcolorbox{ecuacionclave}{enhanced, sharp corners, boxrule=0pt,
  frame hidden, colback=acento!10, left=6pt, right=6pt, top=0pt, bottom=2pt,
  ams align*}

% Estrategia de resolución: cómo abordar un tipo de problema
\newtcolorbox{estrategia}{caja=acento, title={Estrategia de resolución}}

% Repaso y resumen del capítulo
\newcommand{\repasoyresumen}{%
  \section*{Repaso y resumen del capítulo}
  \addcontentsline{toc}{section}{Repaso y resumen del capítulo}}

% Ejercicios. \begin{ejercicio}{clave} ... \end{ejercicio} numera el ejercicio y,
% al final, indica la página de su solución, marcada con \soluciondel{clave}.
\newcounter{ejercicio}[chapter]
\renewcommand{\theejercicio}{\thechapter.\arabic{ejercicio}}
\newenvironment{ejercicio}[1]
  {\def\claveejercicio{#1}%
   \refstepcounter{ejercicio}\label{ej:#1}\par\medskip\noindent
   {\sffamily\bfseries\color{principal}Ejercicio \theejercicio}\quad}
  {\hfill{\sffamily\footnotesize\color{texto-suave}%
     \hyperref[sol:\claveejercicio]{Solución: p.~\pageref*{sol:\claveejercicio}}}%
   \par\medskip}

% Encabezado de la solución de un ejercicio, en el anexo de soluciones
\newcommand{\soluciondel}[1]{%
  \subsection*{Ejercicio \ref{ej:#1}}\label{sol:#1}}
